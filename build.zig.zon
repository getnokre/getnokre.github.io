.{
    .name = .getnokre_site,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x9201b7bf18d63127,
    .dependencies = .{
        // The site is generated by nokre itself: every page is a real
        // nokre element tree, validated at `append` and audited before
        // it is written out. A path dependency because the generator
        // also reads nokre's own `docs/` — which the published package
        // does not carry (see `.paths` in nokre's build.zig.zon).
        .nokre = .{ .path = "../nokre" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "assets",
        "tools",
        "LICENSE",
        "README.md",
    },
}
